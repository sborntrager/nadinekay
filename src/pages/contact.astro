---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact | Nadine Kay" description="Get in touch with Nadine Kay for orders, questions, or custom requests.">
  <section class="max-w-3xl mx-auto px-6 py-20">
    <p class="uppercase tracking-[0.2em] text-xs font-semibold mb-3 text-center" style="color:var(--color-accent);">Say Hello</p>
    <h1 class="text-4xl font-semibold mb-4 text-center" style="font-family:var(--font-heading);">Contact Us</h1>
    <p class="text-[color:var(--color-muted)] text-center mb-12 max-w-lg mx-auto">
      Questions about an order, a scent, or a custom product? Send a message and we'll reply within a day or two.
    </p>

    <form class="grid gap-5 bg-white rounded-[var(--radius-lg)] border border-[color:var(--color-secondary)] shadow-[var(--shadow-soft)] p-8">
      <div class="grid sm:grid-cols-2 gap-5">
        <div>
          <label class="block text-sm font-medium mb-1.5" for="name">Name</label>
          <input id="name" name="name" type="text" required class="w-full rounded-[var(--radius-sm)] border border-[color:var(--color-secondary)] px-4 py-2.5 focus:outline-none focus:ring-2" style="--tw-ring-color:var(--color-primary);" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1.5" for="email">Email</label>
          <input id="email" name="email" type="email" required class="w-full rounded-[var(--radius-sm)] border border-[color:var(--color-secondary)] px-4 py-2.5 focus:outline-none focus:ring-2" style="--tw-ring-color:var(--color-primary);" />
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium mb-1.5" for="message">Message</label>
        <textarea id="message" name="message" rows="5" required class="w-full rounded-[var(--radius-sm)] border border-[color:var(--color-secondary)] px-4 py-2.5 focus:outline-none focus:ring-2" style="--tw-ring-color:var(--color-primary);"></textarea>
      </div>
      <button type="submit" class="button-primary justify-self-start rounded-full px-7 py-3 text-sm font-semibold text-white" style="background:var(--color-primary);">
        Send Message
      </button>
      <p class="text-xs text-[color:var(--color-muted)]">
        Note: this form isn't wired to a backend yet. Connect it to a form service (e.g. Formspree, Cloudflare Workers, or an email API) before launch.
      </p>
    </form>

    <div class="mt-10 text-center text-sm text-[color:var(--color-muted)]">
      Or email us directly at
      <a href="mailto:hello@nadinekay.com" class="font-semibold" style="color:var(--color-primary-dark);">hello@nadinekay.com</a>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProductGrid from '../components/ProductGrid.astro';
import CtaBanner from '../components/CtaBanner.astro';
---
<BaseLayout title="Nadine Kay | Handmade Bath Bombs & Bath Goodies">
  <Hero />

  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="text-center max-w-xl mx-auto mb-12">
      <img src="/logo.png" alt="" class="h-32 w-32 object-contain mx-auto mb-3" />
      <p class="uppercase tracking-[0.2em] text-xs font-semibold mb-3" style="color:var(--color-accent);">Best Sellers</p>
      <h2 class="text-3xl font-semibold" style="font-family:var(--font-heading);">Fan Favorites</h2>
      <p class="text-[color:var(--color-muted)] mt-3">A few of the scents our customers keep coming back for.</p>
    </div>
    <ProductGrid />
  </section>

  <section class="bg-[color:var(--color-surface)] py-16">
    <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-3 gap-10 text-center">
      <div>
        <div class="mx-auto mb-4 h-14 w-14 rounded-full flex items-center justify-center" style="background:var(--color-secondary);">🌿</div>
        <h3 class="font-semibold mb-2" style="font-family:var(--font-heading);">Skin-Loving Ingredients</h3>
        <p class="text-sm text-[color:var(--color-muted)]">Shea butter, coconut oil, and real botanicals in every batch.</p>
      </div>
      <div>
        <div class="mx-auto mb-4 h-14 w-14 rounded-full flex items-center justify-center" style="background:var(--color-secondary);">✋</div>
        <h3 class="font-semibold mb-2" style="font-family:var(--font-heading);">Handmade in Small Batches</h3>
        <p class="text-sm text-[color:var(--color-muted)]">Mixed, poured, and cured by hand &mdash; never mass-produced.</p>
      </div>
      <div>
        <div class="mx-auto mb-4 h-14 w-14 rounded-full flex items-center justify-center" style="background:var(--color-secondary);">💝</div>
        <h3 class="font-semibold mb-2" style="font-family:var(--font-heading);">Perfect for Gifting</h3>
        <p class="text-sm text-[color:var(--color-muted)]">Thoughtful products for self-care, home fragrance, and gifting.</p>
      </div>
    </div>
  </section>

  <CtaBanner
    heading="Ready to treat yourself?"
    subheading="Browse the full collection of home fragrance, bath and body care, and lip products."
    buttonLabel="Shop All Products"
    buttonHref="/shop"
  />
</BaseLayout>

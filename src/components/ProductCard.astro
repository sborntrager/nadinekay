---
interface Props {
  name: string;
  category: string;
  price: string;
  description: string;
  colors: [string, string];
}
const { name, category, price, description, colors } = Astro.props;
---
<div class="group rounded-[var(--radius-lg)] bg-white border border-[color:var(--color-secondary)] overflow-hidden shadow-[var(--shadow-soft)] transition-transform hover:-translate-y-1">
  <div
    class="h-48 flex items-center justify-center"
    style={`background: radial-gradient(circle at 35% 30%, ${colors[0]}, ${colors[1]} 75%);`}
  >
    <div class="h-24 w-24 rounded-full shadow-inner border-4 border-white/60" style={`background: linear-gradient(135deg, ${colors[0]}, ${colors[1]});`}></div>
  </div>
  <div class="p-5">
    <p class="text-xs uppercase tracking-wide font-semibold mb-1" style="color:var(--color-accent);">{category}</p>
    <h3 class="text-lg font-semibold mb-1" style="font-family:var(--font-heading);">{name}</h3>
    <p class="text-sm text-[color:var(--color-muted)] mb-4">{description}</p>
    <div class="flex items-center justify-between">
      <span class="font-semibold" style="color:var(--color-primary-dark);">{price}</span>
      <a href="/contact" class="button-link button-primary text-sm font-semibold rounded-full px-4 py-1.5 text-white" style="background:var(--color-primary);">
        Inquire
      </a>
    </div>
  </div>
</div>

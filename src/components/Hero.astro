<section class="relative overflow-hidden bg-white">
  <div class="grid md:grid-cols-2 items-stretch min-h-[520px]">
    <div
      class="relative flex items-center px-6 md:px-14 py-16 md:py-0"
      style="background: linear-gradient(135deg, #FBF8F5 0%, #F6EFE9 55%, #F3E7E3 100%);"
    >
      <!-- soft leaf texture overlay -->
      <svg
        class="absolute inset-0 w-full h-full opacity-[0.06] pointer-events-none"
        viewBox="0 0 600 500"
        preserveAspectRatio="xMidYMid slice"
        fill="none"
        stroke="currentColor"
        style="color:var(--color-accent);"
      >
        <path d="M40 20 C120 60, 140 160, 60 240 C 20 280, 10 340, 40 420" stroke-width="2" />
        <path d="M120 0 C200 60, 220 160, 140 260 C 100 300, 90 360, 120 460" stroke-width="2" />
        <path d="M200 -20 C280 40, 300 140, 220 240 C 180 290, 170 350, 200 450" stroke-width="2" />
      </svg>

      <div class="relative max-w-md">
        <p class="uppercase tracking-[0.2em] text-xs font-semibold mb-4" style="color:var(--color-accent);">Handmade &middot; Small Batch</p>
        <h1 class="text-4xl md:text-5xl leading-tight font-semibold mb-5" style="font-family:var(--font-heading); color:var(--color-text);">
          Feel good.<br /><span style="font-family:var(--font-script); color:var(--color-primary-dark); font-size:1.15em;">Smell good.</span>
        </h1>
        <p class="text-base md:text-lg text-[color:var(--color-muted)] mb-8">
          Nadine Kay bath bombs are handcrafted in small batches with skin-loving oils and real, honest ingredients &mdash; made to turn an ordinary bath into a little ritual.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/shop" class="button-link button-primary rounded-full px-7 py-3 text-sm font-semibold text-white shadow-[0_10px_24px_rgba(79,184,224,0.35)]" style="background:var(--color-primary);">
            Shop the Collection
          </a>
          <a href="/about" class="button-link button-secondary rounded-full px-7 py-3 text-sm font-semibold border" style="border-color:var(--color-accent); color:var(--color-accent);">
            Our Story
          </a>
        </div>
      </div>
    </div>

    <div class="relative">
      <img
        src="/hero-bath-bombs.png"
        alt="Nadine Kay handmade bath bombs in a bowl"
        class="absolute inset-0 w-full h-full object-cover"
      />
    </div>
  </div>

  <!-- wave divider into next section -->
  <svg class="block w-full text-white" viewBox="0 0 1440 60" preserveAspectRatio="none" style="height:40px;">
    <path fill="currentColor" d="M0,32 C240,60 480,0 720,16 C960,32 1200,56 1440,24 L1440,60 L0,60 Z" />
  </svg>
</section>

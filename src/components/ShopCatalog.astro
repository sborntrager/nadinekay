---

<nav aria-label="Product categories" class="mb-16">
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {categories.map((category) => (
      <a
        href={`#${category.slug}`}
        data-category-link
        class="group overflow-hidden rounded-[var(--radius-lg)] border border-[color:var(--color-secondary)] bg-white shadow-[var(--shadow-soft)] transition hover:-translate-y-1"
      >
        <div
          class="flex h-32 items-center justify-center"
          style={`background:linear-gradient(135deg, ${category.colors[0]}, ${category.colors[1]});`}
        >
          <span class="flex h-16 w-16 items-center justify-center rounded-full border-4 border-white/60 bg-white/15 text-2xl text-white">✦</span>
        </div>
        <div class="p-5">
          <p class="mb-1 text-xs font-semibold uppercase tracking-wide" style="color:var(--color-accent);">Shop category</p>
          <h2 class="text-xl font-semibold" style="font-family:var(--font-heading);">{category.name}</h2>
          <p class="mt-2 text-sm text-[color:var(--color-muted)]">{category.description}</p>
          <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold" style="color:var(--color-primary-dark);">
            View products <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
          </span>
        </div>
      </a>
    ))}
  </div>
</nav>

<div class="space-y-5" aria-label="Products by category">
  {categories.map((category, categoryIndex) => (
    <details
      id={category.slug}
      data-category={category.slug}
      class="scroll-mt-44 overflow-hidden rounded-[var(--radius-lg)] border border-[color:var(--color-secondary)] bg-white shadow-[var(--shadow-soft)]"
      open={categoryIndex === 0}
    >
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 bg-[color:var(--color-surface)] px-6 py-5 marker:content-none">
        <span>
          <span class="block text-2xl font-semibold" style="font-family:var(--font-heading);">{category.name}</span>
          <span class="mt-1 block text-sm text-[color:var(--color-muted)]">{category.description}</span>
        </span>
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-xl text-white" style="background:var(--color-primary);" aria-hidden="true">+</span>
      </summary>

      <div data-product-grid class="grid gap-6 border-t border-[color:var(--color-secondary)] p-6 md:grid-cols-2">
        {category.products.map((product, productIndex) => (
          <article class="grid overflow-hidden rounded-[var(--radius-md)] border border-[color:var(--color-secondary)] sm:grid-cols-[10rem_1fr]">
            <div
              class="flex min-h-40 items-center justify-center"
              style={`background:radial-gradient(circle at 35% 30%, ${category.colors[0]}, ${category.colors[1]} 75%);`}
            >
              <span class="flex h-20 w-20 items-center justify-center rounded-full border-4 border-white/60 bg-white/15 text-2xl text-white" aria-hidden="true">✦</span>
            </div>
            <div class="flex flex-col p-5">
              <p class="text-xs font-semibold uppercase tracking-wide" style="color:var(--color-accent);">{category.name}</p>
              <h3 class="mt-1 text-lg font-semibold" style="font-family:var(--font-heading);">{product.name}</h3>
              <p class="mt-2 flex-1 text-sm leading-6 text-[color:var(--color-muted)]">{product.description}</p>
              <div class="mt-5 flex items-center justify-between gap-3">
                <span class="font-semibold" style="color:var(--color-primary-dark);">{product.price}</span>
                <a
                  href={`/contact?product=${encodeURIComponent(product.name)}`}
                  class="button-link button-primary rounded-full px-4 py-2 text-sm font-semibold text-white"
                  style="background:var(--color-primary);"
                >Buy</a>
              </div>
              <span class="sr-only">Placeholder product {productIndex + 1}</span>
            </div>
          </article>
        ))}
      </div>
    </details>
  ))}
</div>

<script>
  document.querySelectorAll('[data-category-link]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const targetId = link.getAttribute('href')?.slice(1);
      const target = targetId ? document.getElementById(targetId) : null;
      if (!(target instanceof HTMLDetailsElement)) return;

      event.preventDefault();
      target.open = true;
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      history.replaceState(null, '', `#${targetId}`);
    });
  });

  const hashTarget = document.getElementById(window.location.hash.slice(1));
  if (hashTarget instanceof HTMLDetailsElement) hashTarget.open = true;

  const escapeHtml = (value) => String(value ?? '').replace(/[&<>'"]/g, (character) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;',
  })[character]);
  const money = (cents) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(Number(cents || 0) / 100);

  fetch('/api/catalog/products')
    .then((response) => response.ok ? response.json() : Promise.reject())
    .then(({ products = [] }) => {
      document.querySelectorAll('[data-category]').forEach((section) => {
        const categoryProducts = products.filter((product) => product.category_slug === section.dataset.category);
        const grid = section.querySelector('[data-product-grid]');
        if (!grid || !categoryProducts.length) return;
        grid.innerHTML = categoryProducts.map((product) => `
          <article class="grid overflow-hidden rounded-[var(--radius-md)] border border-[color:var(--color-secondary)] sm:grid-cols-[10rem_1fr]">
            <div class="flex min-h-40 items-center justify-center bg-[color:var(--color-surface)]">
              ${product.image_url ? `<img src="${escapeHtml(product.image_url)}" alt="${escapeHtml(product.name)}" class="h-full min-h-40 w-full object-cover">` : '<span class="flex h-20 w-20 items-center justify-center rounded-full border-4 border-white bg-[color:var(--color-secondary)] text-2xl text-white" aria-hidden="true">✦</span>'}
            </div>
            <div class="flex flex-col p-5">
              <p class="text-xs font-semibold uppercase tracking-wide" style="color:var(--color-accent);">${escapeHtml(product.category)}</p>
              <h3 class="mt-1 text-lg font-semibold" style="font-family:var(--font-heading);">${escapeHtml(product.name)}</h3>
              <p class="mt-2 flex-1 text-sm leading-6 text-[color:var(--color-muted)]">${escapeHtml(product.description)}</p>
              <div class="mt-5 flex items-center justify-between gap-3">
                <span class="font-semibold" style="color:var(--color-primary-dark);">${money(product.price_cents)}</span>
                <a href="/contact?product=${encodeURIComponent(product.name)}" class="button-link button-primary rounded-full px-4 py-2 text-sm font-semibold text-white" style="background:var(--color-primary);">Buy</a>
              </div>
            </div>
          </article>
        `).join('');
      });
    })
    .catch(() => {
      // The static seed catalog remains visible until Cloudflare bindings are configured.
    });
</script>

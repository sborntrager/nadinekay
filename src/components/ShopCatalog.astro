---
const categories = [
  {
    name: 'Candles',
    slug: 'candles',
    description: 'Hand-poured fragrance for every room.',
    colors: ['#F6E0B8', '#D9A875'],
    products: [
      { name: 'Signature Candle No. 1', description: 'A hand-poured candle with a warm, welcoming fragrance.', price: '$18.00' },
      { name: 'Signature Candle No. 2', description: 'A clean-burning candle created for everyday moments.', price: '$18.00' },
    ],
  },
  {
    name: 'Carpet Seasoning',
    slug: 'carpet-seasoning',
    description: 'Fresh fragrance for carpets and rugs.',
    colors: ['#C9B6F2', '#8E7DC6'],
    products: [
      { name: 'Carpet Seasoning No. 1', description: 'A scented carpet refresher for a clean, inviting home.', price: '$12.00' },
      { name: 'Carpet Seasoning No. 2', description: 'An easy-to-use powder that refreshes carpets and rugs.', price: '$12.00' },
    ],
  },
  {
    name: 'Air Freshener',
    slug: 'air-freshener',
    description: 'Room and linen sprays for a quick refresh.',
    colors: ['#8FD9EC', '#3FA9C9'],
    products: [
      { name: 'Air Freshener No. 1', description: 'A light room spray made to refresh everyday spaces.', price: '$10.00' },
      { name: 'Air Freshener No. 2', description: 'A versatile fragrance mist for rooms and linens.', price: '$10.00' },
    ],
  },
  {
    name: 'Bath Bombs',
    slug: 'bath-bombs',
    description: 'Colorful fizz with skin-loving ingredients.',
    colors: ['#F7B8CE', '#E9789F'],
    products: [
      { name: 'Bath Bomb No. 1', description: 'A fragrant bath bomb for a relaxing, fizzy soak.', price: '$8.00' },
      { name: 'Bath Bomb No. 2', description: 'A colorful bath treat made with skin-loving oils.', price: '$8.00' },
    ],
  },
  {
    name: 'Soaps',
    slug: 'soaps',
    description: 'Gentle handmade soaps with rich lather.',
    colors: ['#B9E4D0', '#5FB893'],
    products: [
      { name: 'Handmade Soap No. 1', description: 'A gentle handmade soap with a creamy, rich lather.', price: '$9.00' },
      { name: 'Handmade Soap No. 2', description: 'An everyday cleansing bar with an inviting scent.', price: '$9.00' },
    ],
  },
  {
    name: 'Body Butter',
    slug: 'body-butter',
    description: 'Rich moisture for soft, nourished skin.',
    colors: ['#FFD37A', '#F4A94A'],
    products: [
      { name: 'Body Butter No. 1', description: 'A rich whipped moisturizer for soft, nourished skin.', price: '$16.00' },
      { name: 'Body Butter No. 2', description: 'A velvety body butter made for lasting moisture.', price: '$16.00' },
    ],
  },
  {
    name: 'Body Scrub',
    slug: 'body-scrub',
    description: 'Smoothing exfoliation for silky-soft skin.',
    colors: ['#EADFCB', '#C9A876'],
    products: [
      { name: 'Body Scrub No. 1', description: 'A smoothing sugar scrub that gently buffs dry skin.', price: '$14.00' },
      { name: 'Body Scrub No. 2', description: 'A fragrant exfoliating scrub for a soft, polished finish.', price: '$14.00' },
    ],
  },
  {
    name: 'Body Oil',
    slug: 'body-oil',
    description: 'Lightweight oils for a healthy-looking glow.',
    colors: ['#F4C6D6', '#D9A875'],
    products: [
      { name: 'Body Oil No. 1', description: 'A lightweight moisturizing oil for a healthy-looking glow.', price: '$15.00' },
      { name: 'Body Oil No. 2', description: 'A silky body oil that absorbs easily and leaves skin soft.', price: '$15.00' },
    ],
  },
  {
    name: 'Lip Gloss',
    slug: 'lip-gloss',
    description: 'Smooth shine and comfortable lip care.',
    colors: ['#F7B8CE', '#D9A875'],
    products: [
      { name: 'Lip Gloss No. 1', description: 'A smooth gloss with comfortable shine for everyday wear.', price: '$8.00' },
      { name: 'Lip Gloss No. 2', description: 'A moisturizing gloss that gives lips a polished finish.', price: '$8.00' },
    ],

---
const links = [
  { href: '/', label: 'Home' },
  { href: '/shop', label: 'Shop' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  { href: '/account', label: 'Account' },
];
const current = Astro.url.pathname;
---
<header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-[color:var(--color-secondary)]">
  <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-4">
      <img src="/logo.png" alt="Nadine Kay" class="h-32 w-32 object-contain" />
      <span class="flex flex-col leading-none">
        <span
          class="text-2xl"
          style="font-family:var(--font-script); color:var(--color-primary-dark);"
        >Nadine Kay</span>
        <span class="mt-1 flex items-baseline gap-1 whitespace-nowrap">
          <span
            class="text-sm font-medium"
            style="font-family:var(--font-heading); color:var(--color-text);"
          >Feel good.</span>
          <span
            class="text-xl"
            style="font-family:var(--font-script); color:var(--color-primary);"
          >Smell good.</span>
        </span>
      </span>
    </a>
    <nav class="hidden md:flex items-center gap-8">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={[
            'text-sm font-medium tracking-wide transition-colors hover:text-[color:var(--color-primary-dark)]',
            current === l.href ? 'text-[color:var(--color-primary-dark)]' : 'text-[color:var(--color-text)]',
          ]}
        >{l.label}</a>
      ))}
    </nav>
    <a
      href="/shop"
      class="button-link button-primary hidden md:inline-block rounded-full px-5 py-2 text-sm font-semibold text-white shadow-[0_8px_20px_rgba(79,184,224,0.35)]"
      style="background:var(--color-primary);"
    >Shop Now</a>

    <!-- mobile menu -->
    <details class="md:hidden relative">
      <summary class="list-none cursor-pointer p-2 -mr-2 rounded-md hover:bg-[color:var(--color-surface)]">
        <span class="sr-only">Menu</span>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
        </svg>
      </summary>
      <nav class="absolute right-0 top-full mt-2 w-44 rounded-[var(--radius-md)] bg-white shadow-lg border border-[color:var(--color-secondary)] p-2 flex flex-col">
        {links.map((l) => (
          <a href={l.href} class="px-3 py-2 rounded-md text-sm font-medium hover:bg-[color:var(--color-surface)]">{l.label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>

---
interface Props {
  heading: string;
  subheading?: string;
  buttonLabel: string;
  buttonHref: string;
}
const { heading, subheading = '', buttonLabel, buttonHref } = Astro.props;
---
<section class="max-w-6xl mx-auto px-6 my-20">
  <div
    class="rounded-[var(--radius-lg)] px-8 py-14 text-center"
    style="background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);"
  >
    <h2 class="text-2xl md:text-3xl font-semibold text-white mb-3" style="font-family:var(--font-heading);">{heading}</h2>
    {subheading && <p class="text-white/85 max-w-xl mx-auto mb-6">{subheading}</p>}
    <a href={buttonHref} class="button-link button-light inline-block rounded-full px-7 py-3 text-sm font-semibold bg-white" style="color:var(--color-primary-dark);">
      {buttonLabel}
    </a>
  </div>
</section>
